# Supabase project > Settings > API. These two values are public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: used only by the live test's disposable-account setup/cleanup, never by the app.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Required for Decode, not other features.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
APP_ORIGIN=http://127.0.0.1:3000
# Optional development seed script credentials (an existing confirmed account).
SEED_EMAIL=
SEED_PASSWORD=
